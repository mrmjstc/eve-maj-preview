// The relay for games between players (src/multiplayer/); deploy with `npx wrangler deploy` from this folder.
{
  "name": "eve-maj-pong",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per IP, separately for hosting and joining, so codes can't be swept.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // Off, so no request log (and with it no player's IP) is kept.
  "observability": { "enabled": false }
}
