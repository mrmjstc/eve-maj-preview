#!/bin/sh
# Runs the checkers before a push; install with: cp tools/checks/pre-push .git/hooks/pre-push
# Skip once with git push --no-verify.

cd "$(git rev-parse --show-toplevel)" || exit 1
python tools/checks/run_all.py > /dev/null || {
    echo "pre-push: run python tools/checks/run_all.py to see why, or push with --no-verify" >&2
    exit 1
}
